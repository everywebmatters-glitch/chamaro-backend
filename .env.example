DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Optional. Path to a PEM CA certificate for validating the database server's TLS
# certificate (e.g. a Google Cloud SQL instance's server-ca.pem). Leave unset when
# the server's certificate chains to a publicly trusted root.
DATABASE_CA_CERT_PATH=
# Optional. The same CA as PEM text, for hosts where no certificate file is deployed
# (e.g. Hostinger). Takes precedence over DATABASE_CA_CERT_PATH. Newlines may be real
# line breaks or written as \n on a single line.
DATABASE_CA_CERT=
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins. Production (APP_ENV=production) rejects localhost; the dev
# storefront there is CORS_ORIGIN=https://dev.chamaro.com (append other frontends, e.g. Admin).
CORS_ORIGIN=http://localhost:3000
APP_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Backend callback; must be an authorised redirect URI on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Frontend page that receives #code=... (or #error=...) and calls POST /api/v1/auth/google/exchange.
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/account/google/callback/
SSO_API_URL=
SSO_API_KEY=
# Cloud Run (Cloud SQL socket) form, placeholders only. Production: project-d95e700a-8cd9-4c1a-bd5, instance
# chamaro-mysql-prod, database chamaro, runtime account chamaro_app (SELECT/INSERT/UPDATE/DELETE only):
# DATABASE_URL="mysql://chamaro_app:PASSWORD@localhost/chamaro?socket=/cloudsql/project-d95e700a-8cd9-4c1a-bd5:asia-south1:chamaro-mysql-prod"
# Schema migrations run as a separate account (chamaro_migrator) in the chamaro-migrate Cloud Run job only, whose
# Secret Manager secret DATABASE_URL_MIGRATE is mapped to DATABASE_URL there. Never use it in the API or workers.
# Local access to the same instance goes through the Cloud SQL Auth Proxy: DATABASE_URL="mysql://chamaro_app:PASSWORD@127.0.0.1:3307/chamaro"
# Resend (https://resend.com) -- backend-only. Never expose to Next.js/browser code.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Chamaro <noreply@chamaro.com>".
RESEND_FROM_EMAIL=
# Email OTP (login / forgot-password / checkout) tuning. Defaults shown are also the
# in-code fallback when unset.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW="10 minutes"
CHECKOUT_VERIFICATION_TTL_MINUTES=15
# Customer storefront that email links point at (password reset: APP_BASE_URL/reset-password#token=...).
# Production defaults to https://chamaro.com and must be https; never the admin domain.
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Delhivery courier (backend-only; never expose to Next.js/browser code). Off unless DELHIVERY_ENABLED=true.
# Outside APP_ENV=production only the staging host is accepted, so a local run can never create a real shipment.
DELHIVERY_ENABLED=false
DELHIVERY_API_BASE_URL=https://staging-express.delhivery.com
# Staging token from Delhivery onboarding (production uses a different token, from Secret Manager).
DELHIVERY_API_TOKEN=
# Warehouse name exactly as registered with Delhivery (case sensitive).
DELHIVERY_PICKUP_LOCATION=
# Warehouse PIN used as the origin for the customer shipping-charge estimate.
DELHIVERY_ORIGIN_PIN=600118
# Bearer token Delhivery's scan push must send (Authorization: Bearer ...). 32+ random characters.
DELHIVERY_WEBHOOK_SECRET=
# Optional; sent with every shipment when set.
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
DELHIVERY_TIMEOUT_MS=15000
# Razorpay payments (backend-only; never expose the secrets to Next.js/browser code). Keep disabled locally until
# test keys are configured. Configure the webhook URL as https://api.chamaro.com/api/v1/payments/razorpay/webhook.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set as the webhook secret in Razorpay's dashboard (not the key secret). 16+ random characters.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE_KEYS=false
RAZORPAY_TIMEOUT_MS=15000
