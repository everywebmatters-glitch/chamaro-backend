generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique @db.VarChar(191)
  googleId     String?    @unique @db.VarChar(191)
  passwordHash String
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  adminProfile AdminUser?
  customer     Customer?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role, isActive])
}

// Admin-domain profile. Identity/credentials stay on User; authorization still keys off User.role.
model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  lastLoginAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum CustomerType {
  RETAIL
  B2B
}

model Customer {
  id           String          @id @default(cuid())
  userId       String          @unique
  customerType CustomerType    @default(RETAIL)
  phone        String?         @db.VarChar(32)
  companyName  String?         @db.VarChar(191)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    RetailAddress[]
  cart         Cart?
  retailOrders RetailOrder[]
  b2bEnquiries B2BEnquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([customerType])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique @db.VarChar(191)
  description String?      @db.Text
  status      RecordStatus @default(DRAFT)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, name])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique @db.VarChar(191)
  description       String?            @db.Text
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  sku               String?            @unique @db.VarChar(191)
  status            RecordStatus       @default(DRAFT)
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  variants          ProductVariant[]
  inventory         Inventory?
  cartItems         CartItem[]
  retailOrderItems  RetailOrderItem[]
  b2bEnquiryItems   B2BEnquiryItem[]
  b2bQuotationItems B2BQuotationItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, categoryId])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.VarChar(2048)
  altText   String?  @db.VarChar(500)
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id               String            @id @default(cuid())
  productId        String
  name             String
  sku              String            @unique @db.VarChar(191)
  price            Decimal?          @db.Decimal(12, 2)
  options          Json
  status           RecordStatus      @default(ACTIVE)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  retailOrderItems RetailOrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId, status])
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CmsPage {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique @db.VarChar(191)
  status         PageStatus   @default(DRAFT)
  seoTitle       String?      @db.VarChar(191)
  seoDescription String?      @db.VarChar(500)
  sections       CmsSection[]
  banners        Banner[]
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, slug])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String   @db.VarChar(100)
  content   Json
  position  Int      @default(0)
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
}

model Banner {
  id             String       @id @default(cuid())
  title          String
  imageUrl       String       @db.VarChar(2048)
  mobileImageUrl String?      @db.VarChar(2048)
  linkUrl        String?      @db.VarChar(2048)
  altText        String?      @db.VarChar(500)
  status         RecordStatus @default(DRAFT)
  position       Int          @default(0)
  pageId         String?
  page           CmsPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, position])
  @@index([status, startAt, endAt, position])
  @@index([pageId])
}

model Media {
  id        String   @id @default(cuid())
  url       String   @db.VarChar(2048)
  urlHash   String   @unique @db.Char(64)
  filename  String   @db.VarChar(500)
  altText   String?  @db.VarChar(500)
  mimeType  String   @db.VarChar(191)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mimeType])
}

// ---------------------------------------------------------------------------
// RETAIL — website purchases (cart → checkout → order). Separate from B2B.
// ---------------------------------------------------------------------------

enum AddressType {
  SHIPPING
  BILLING
}

model RetailAddress {
  id           String        @id @default(cuid())
  customerId   String
  name         String        @db.VarChar(191)
  phone        String        @db.VarChar(32)
  addressLine1 String        @db.VarChar(255)
  addressLine2 String?       @db.VarChar(255)
  city         String        @db.VarChar(120)
  state        String        @db.VarChar(120)
  postalCode   String        @db.VarChar(20)
  country      String        @db.VarChar(2)
  type         AddressType   @default(SHIPPING)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       RetailOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

enum RetailOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model RetailOrder {
  id                String            @id @default(cuid())
  customerId        String
  status            RetailOrderStatus @default(PENDING)
  subtotal          Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  shippingAddressId String?
  // Order history must survive: customers/addresses referenced by an order cannot be deleted.
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress   RetailAddress?    @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items             RetailOrderItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([shippingAddressId])
}

model RetailOrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  // Price at time of purchase, not a live reference to the catalogue price.
  unitPrice Decimal         @db.Decimal(12, 2)
  order     RetailOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// B2B — enquiry/lead workflow → quotation → (later) order. Not a retail order.
// ---------------------------------------------------------------------------

enum B2BEnquiryStatus {
  NEW
  CONTACTED
  REQUIREMENT_RECEIVED
  QUOTATION_SENT
  NEGOTIATING
  CONVERTED
  CLOSED
}

model B2BEnquiry {
  id               String           @id @default(cuid())
  // Nullable: businesses may enquire before (or without) creating an account.
  customerId       String?
  status           B2BEnquiryStatus @default(NEW)
  // Contact details are captured on the enquiry itself as submitted.
  companyName      String           @db.VarChar(191)
  contactName      String           @db.VarChar(191)
  email            String           @db.VarChar(191)
  phone            String?          @db.VarChar(32)
  message          String?          @db.Text
  expectedTimeline String?          @db.VarChar(191)
  // Internal admin notes, never shown to the customer.
  notes            String?          @db.Text
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            B2BEnquiryItem[]
  quotations       B2BQuotation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

model B2BEnquiryItem {
  id           String     @id @default(cuid())
  enquiryId    String
  // Nullable: a business may request something not (yet) in the catalogue.
  productId    String?
  quantity     Int
  requirements String?    @db.Text
  notes        String?    @db.Text
  enquiry      B2BEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([productId])
}

enum B2BQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model B2BQuotation {
  id              String             @id @default(cuid())
  enquiryId       String
  quotationNumber String             @unique @db.VarChar(64)
  status          B2BQuotationStatus @default(DRAFT)
  subtotal        Decimal            @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  validUntil      DateTime?
  notes           String?            @db.Text
  enquiry         B2BEnquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items           B2BQuotationItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([enquiryId])
  @@index([status])
}

model B2BQuotationItem {
  id          String       @id @default(cuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  quotation   B2BQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
}
