generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique @db.VarChar(191)
  googleId             String?               @unique @db.VarChar(191)
  passwordHash         String
  role                 Role                  @default(ADMIN)
  isActive             Boolean               @default(true)
  // When the account holder last proved they read mail at `email` (an emailed code or link they used, or a
  // Google-verified address). NULL for accounts that never did, including every account created before this
  // column existed; notification emails are not sent to an address that is still NULL here.
  emailVerifiedAt      DateTime?
  adminProfile         AdminUser?
  customer             Customer?
  checkoutVerification CheckoutVerification?
  passwordResetTokens  PasswordResetToken[]
  emailNotifications   EmailNotification[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([role, isActive])
}

// Single-use password-reset links. Only the SHA-256 of the random token is stored (the token itself
// is in the emailed link and nowhere else). usedAt is set exactly once, by a conditional update, when
// the link resets a password or is superseded, so a token can never be redeemed twice.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum OtpPurpose {
  LOGIN
  FORGOT_PASSWORD
  CHECKOUT_PAYMENT
  EMAIL_VERIFICATION
}

// Email-delivered one-time codes for login, password reset, and checkout/payment
// authorization. otpHash uses the same scrypt format as User.passwordHash -- the plaintext
// code is never stored. consumedAt marks a code used (directly, or invalidated by a newer
// code for the same email+purpose) so it can never be verified again.
model EmailOtp {
  id         String     @id @default(cuid())
  email      String     @db.VarChar(191)
  purpose    OtpPurpose
  otpHash    String
  // Set only for codes issued to an already-authenticated user (checkout), as an extra binding
  // check alongside email.
  userId     String?
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, consumedAt])
  @@index([userId, purpose])
}

// Short-lived proof that an authenticated customer completed checkout/payment OTP
// verification. Payment-initiation code must look this up (and consume it) before starting a
// payment -- a client-supplied "otpVerified" flag must never be trusted on its own.
model CheckoutVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Admin-domain profile. Identity/credentials stay on User; authorization still keys off User.role.
model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  lastLoginAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum CustomerType {
  RETAIL
  B2B
}

model Customer {
  id           String          @id @default(cuid())
  userId       String          @unique
  customerType CustomerType    @default(RETAIL)
  phone        String?         @db.VarChar(32)
  companyName  String?         @db.VarChar(191)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    RetailAddress[]
  cart         Cart?
  retailOrders RetailOrder[]
  b2bEnquiries B2BEnquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([customerType])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique @db.VarChar(191)
  description String?      @db.Text
  status      RecordStatus @default(DRAFT)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, name])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique @db.VarChar(191)
  description       String?            @db.Text
  // Storefront product-page tabs. Lists are JSON arrays of strings; specifications is
  // [{ label, value }]. Empty returnPolicy/warranty mean "use the store-wide default".
  features          Json?
  materials         Json?
  specifications    Json?
  returnPolicy      String?            @db.Text
  warranty          String?            @db.Text
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  sku               String?            @unique @db.VarChar(191)
  status            RecordStatus       @default(DRAFT)
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  variants          ProductVariant[]
  inventory         Inventory?
  cartItems         CartItem[]
  retailOrderItems  RetailOrderItem[]
  b2bEnquiryItems   B2BEnquiryItem[]
  b2bQuotationItems B2BQuotationItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, categoryId])
  @@index([name])
}

// An image shown on a product. New images reference an uploaded Media record (mediaId), whose
// bytes the API serves at /api/v1/media/:id. `url` only holds legacy externally hosted images.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  mediaId   String?
  url       String?  @db.VarChar(2048)
  altText   String?  @db.VarChar(500)
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Restrict: media still shown on a product can't be deleted (409 RECORD_IN_USE).
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
  @@index([productId, isPrimary])
  @@index([mediaId])
}

model ProductVariant {
  id               String            @id @default(cuid())
  productId        String
  name             String
  sku              String            @unique @db.VarChar(191)
  price            Decimal?          @db.Decimal(12, 2)
  options          Json
  status           RecordStatus      @default(ACTIVE)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  retailOrderItems RetailOrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId, status])
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CmsPage {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique @db.VarChar(191)
  status         PageStatus   @default(DRAFT)
  seoTitle       String?      @db.VarChar(191)
  seoDescription String?      @db.VarChar(500)
  sections       CmsSection[]
  banners        Banner[]
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, slug])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String   @db.VarChar(100)
  content   Json
  position  Int      @default(0)
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
}

model Banner {
  id             String       @id @default(cuid())
  title          String
  imageUrl       String       @db.VarChar(2048)
  mobileImageUrl String?      @db.VarChar(2048)
  linkUrl        String?      @db.VarChar(2048)
  altText        String?      @db.VarChar(500)
  status         RecordStatus @default(DRAFT)
  position       Int          @default(0)
  pageId         String?
  page           CmsPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, position])
  @@index([status, startAt, endAt, position])
  @@index([pageId])
}

// A media file. Uploaded files are stored here (`data`, `size`) and served by the API;
// externally hosted files registered earlier only have `url`/`urlHash`.
// Queries must omit `data` except the media-serving route, so lists never load blobs.
model Media {
  id            String         @id @default(cuid())
  url           String?        @db.VarChar(2048)
  urlHash       String?        @unique @db.Char(64)
  filename      String         @db.VarChar(500)
  altText       String?        @db.VarChar(500)
  mimeType      String         @db.VarChar(191)
  size          Int?
  data          Bytes?         @db.MediumBlob
  metadata      Json?
  productImages ProductImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([mimeType])
}

// ---------------------------------------------------------------------------
// RETAIL — website purchases (cart → checkout → order). Separate from B2B.
// ---------------------------------------------------------------------------

enum AddressType {
  SHIPPING
  BILLING
}

model RetailAddress {
  id           String        @id @default(cuid())
  customerId   String
  name         String        @db.VarChar(191)
  phone        String        @db.VarChar(32)
  addressLine1 String        @db.VarChar(255)
  addressLine2 String?       @db.VarChar(255)
  city         String        @db.VarChar(120)
  state        String        @db.VarChar(120)
  postalCode   String        @db.VarChar(20)
  country      String        @db.VarChar(2)
  type         AddressType   @default(SHIPPING)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       RetailOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

enum RetailOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

// Payment is tracked separately from fulfilment. Only a verified payment-provider confirmation may move an order
// to PAID; nothing in the API does that yet, so every order is UNPAID.
enum RetailPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model RetailOrder {
  id                      String              @id @default(cuid())
  customerId              String
  status                  RetailOrderStatus   @default(PENDING)
  paymentStatus           RetailPaymentStatus @default(UNPAID)
  subtotal                Decimal             @db.Decimal(12, 2)
  shippingTotal           Decimal             @default(0) @db.Decimal(12, 2)
  total                   Decimal             @db.Decimal(12, 2)
  shippingMethod          String?             @db.VarChar(32)
  // Copy of the address at order time, so editing an address later never rewrites past orders.
  shippingAddressSnapshot Json?
  note                    String?             @db.Text
  // Client-chosen key (Idempotency-Key header): a retried request returns the order it already created.
  idempotencyKey          String?             @db.VarChar(64)
  // Set together when an admin marks the order SHIPPED. Entered by hand; no shipping-provider integration yet.
  carrier                 String?             @db.VarChar(64)
  trackingNumber          String?             @db.VarChar(128)
  shippedAt               DateTime?
  shippingAddressId       String?
  // Order history must survive: customers/addresses referenced by an order cannot be deleted.
  customer                Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress         RetailAddress?      @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items                   RetailOrderItem[]
  emailNotifications      EmailNotification[]
  payments                Payment[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([shippingAddressId])
}

// One row per gateway order (a Razorpay "order_..."): an attempt to pay one RetailOrder. Its state is only ever
// copied from the gateway's API (never from a browser or a webhook body), and only moves forward:
// CREATED/FAILED -> AUTHORIZED -> CAPTURED -> PARTIALLY_REFUNDED -> REFUNDED. FAILED means the latest try failed; the
// customer may still pay this same gateway order. No card, UPI or bank details are stored: only the gateway's ids,
// the amount, the method name and the gateway's fixed error code.
enum PaymentStatus {
  CREATED
  FAILED
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  provider            String        @default("RAZORPAY") @db.VarChar(32)
  // "test" or "live": the Razorpay key mode the gateway order was created with. A test-mode payment moves no real
  // money, so an order paid that way is never shipped, and a gateway order is only ever read back with keys of its mode.
  mode                String        @db.VarChar(4)
  providerOrderId     String        @unique @db.VarChar(64)
  // The gateway payment ("pay_...") that was authorized or captured. NULL until one is.
  providerPaymentId   String?       @unique @db.VarChar(64)
  amountMinor         Int
  currency            String        @default("INR") @db.Char(3)
  status              PaymentStatus @default(CREATED)
  amountRefundedMinor Int           @default(0)
  // "upi", "card", "netbanking", "wallet"... as the gateway reports it.
  method              String?       @db.VarChar(32)
  // The gateway's fixed error code and step from the last failed try, never its free-text description.
  lastErrorCode       String?       @db.VarChar(64)
  lastErrorReason     String?       @db.VarChar(64)
  // Set when money moved in a way that needs a person: a payment for an order that was already cancelled or paid,
  // or an amount that does not match the order. Such a payment never marks the order paid.
  needsReview         Boolean       @default(false)
  reviewReason        String?       @db.VarChar(64)
  authorizedAt        DateTime?
  capturedAt          DateTime?
  refundedAt          DateTime?
  lastSyncedAt        DateTime?
  order               RetailOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  @@index([needsReview])
  @@index([mode, status])
}

// Webhook deliveries already received, by the gateway's event id, so a redelivered event is processed once. Only ids
// and the event name are kept; the body (which holds customer contact details) is never stored.
model PaymentWebhookEvent {
  id                String    @id @default(cuid())
  provider          String    @default("RAZORPAY") @db.VarChar(32)
  eventId           String    @unique @db.VarChar(64)
  event             String    @db.VarChar(64)
  providerPaymentId String?   @db.VarChar(64)
  processedAt       DateTime?
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RetailOrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  quantity    Int
  // Price at time of purchase, not a live reference to the catalogue price.
  unitPrice   Decimal         @db.Decimal(12, 2)
  // Names and SKU at time of purchase (the catalogue may be edited later).
  productName String?         @db.VarChar(191)
  variantName String?         @db.VarChar(191)
  sku         String?         @db.VarChar(191)
  order       RetailOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Email outbox: notifications that carry no secret (order, shipment, cancellation, password-changed).
// ---------------------------------------------------------------------------

// PENDING: waiting for its next attempt (nextAttemptAt). SENDING: claimed by one sender until lockedUntil.
// SENT: the provider accepted it. FAILED: given up (see lastErrorName). SKIPPED: never sent (see skipReason).
enum EmailNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// One row per notification, written in the same transaction as the change it reports, so a notification exists
// exactly when its change committed. eventKey names the event (e.g. "order:<id>:placed"): it is unique here, so an
// event is recorded once, and it is the provider's idempotency key, so a retry after an unrecorded success is not
// delivered twice. The message is stored rendered, so every attempt sends identical content. Codes and reset links
// are never written here; those emails are sent directly and are not retried.
model EmailNotification {
  id                String                  @id @default(cuid())
  eventKey          String                  @unique @db.VarChar(191)
  kind              String                  @db.VarChar(32)
  toEmail           String                  @db.VarChar(191)
  userId            String?
  orderId           String?
  subject           String                  @db.VarChar(255)
  html              String                  @db.MediumText
  text              String                  @db.Text
  status            EmailNotificationStatus @default(PENDING)
  skipReason        String?                 @db.VarChar(64)
  attempts          Int                     @default(0)
  nextAttemptAt     DateTime                @default(now())
  lockedUntil       DateTime?
  // The provider's fixed error name and HTTP status from the last failed attempt; never its message text.
  lastErrorName     String?                 @db.VarChar(64)
  lastErrorStatus   Int?
  providerMessageId String?                 @db.VarChar(191)
  sentAt            DateTime?
  user              User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             RetailOrder?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// B2B — enquiry/lead workflow → quotation → (later) order. Not a retail order.
// ---------------------------------------------------------------------------

enum B2BEnquiryStatus {
  NEW
  CONTACTED
  REQUIREMENT_RECEIVED
  QUOTATION_SENT
  NEGOTIATING
  CONVERTED
  CLOSED
}

model B2BEnquiry {
  id               String           @id @default(cuid())
  // Nullable: businesses may enquire before (or without) creating an account.
  customerId       String?
  status           B2BEnquiryStatus @default(NEW)
  // Contact details are captured on the enquiry itself as submitted.
  companyName      String           @db.VarChar(191)
  contactName      String           @db.VarChar(191)
  email            String           @db.VarChar(191)
  phone            String?          @db.VarChar(32)
  message          String?          @db.Text
  expectedTimeline String?          @db.VarChar(191)
  // Internal admin notes, never shown to the customer.
  notes            String?          @db.Text
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            B2BEnquiryItem[]
  quotations       B2BQuotation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

model B2BEnquiryItem {
  id           String     @id @default(cuid())
  enquiryId    String
  // Nullable: a business may request something not (yet) in the catalogue.
  productId    String?
  quantity     Int
  requirements String?    @db.Text
  notes        String?    @db.Text
  enquiry      B2BEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([productId])
}

enum B2BQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model B2BQuotation {
  id              String             @id @default(cuid())
  enquiryId       String
  quotationNumber String             @unique @db.VarChar(64)
  status          B2BQuotationStatus @default(DRAFT)
  subtotal        Decimal            @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  validUntil      DateTime?
  notes           String?            @db.Text
  enquiry         B2BEnquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items           B2BQuotationItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([enquiryId])
  @@index([status])
}

model B2BQuotationItem {
  id          String       @id @default(cuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  quotation   B2BQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
}
